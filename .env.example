# Подключение к PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/sg_360review

# Секрет для Flask-сессии
SECRET_KEY=change-me

# Окружение: development | production
FLASK_ENV=development

# Порог анонимности по умолчанию для новых компаний
ANON_THRESHOLD=3

# Фоновые задачи (APScheduler)
SCHEDULER_ENABLED=1
SCHEDULER_INTERVAL_MIN=5
REMINDER_DAYS_BEFORE=3

# Email: console (лог) | null (выкл). Реальный провайдер подключим позже.
EMAIL_BACKEND=console
# Базовый URL для ссылок в письмах, напр. https://app.example.com
APP_BASE_URL=
